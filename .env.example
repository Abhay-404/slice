# Copy to .env.local (which is gitignored) and fill in.
#
#   cp .env.example .env.local
#
# NOTE: .gitignore currently matches `.env*`, so this example file itself is
# ignored by git. Add an exception line `!.env.example` if you want it tracked.

# ---------------------------------------------------------------- required --

# Gemini Developer API key. Get one at https://aistudio.google.com/apikey
#
# Server-side only. It is used to mint short-lived ephemeral tokens in
# app/api/live-token/route.ts and is NEVER sent to the browser.
#
# Must be a Gemini Developer API key, not a Vertex AI credential -- ephemeral
# tokens for the Live API only exist on the Developer API.
GEMINI_API_KEY=

# ---------------------------------------------------------------- optional --

# Override the Live model without touching code. Defaults to
# LIVE_CONFIG.model in lib/live/config.ts (gemini-3.1-flash-live-preview).
# Documented fallback: gemini-2.5-flash-native-audio-preview-12-2025
# GEMINI_LIVE_MODEL=

# Set to 1 to lock the minted token to a single model (liveConnectConstraints).
# Tighter security, but the browser's connect config must then match the
# server's exactly or the API silently ignores the client's values.
# Leave unset until the config has stopped changing.
# LIVE_TOKEN_CONSTRAIN=
